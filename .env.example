# ---------------------------------------------------------------------------
# GM CRYPTO ARBITRAGE AI — variabili d'ambiente (tutte opzionali in sviluppo)
# Copia in .env solo ciò che ti serve. Non committare mai .env.
# ---------------------------------------------------------------------------

# Percorso del database SQLite e della directory dati (default: ./data)
# GM_DB_PATH=./data/gm.db
# GM_DATA_DIR=./data

# Chiave master per AES-256-GCM (32 byte in base64). Se assente viene
# generato data/master.key con permessi 0600. In produzione usa questa.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GM_ENCRYPTION_KEY=

# Account creati al primo avvio. Se le password non sono impostate, ne viene
# generata una casuale e stampata una sola volta nel log del server.
# GM_ADMIN_EMAIL=admin@gmarbitrage.ai
# GM_ADMIN_PASSWORD=
# GM_DEMO_PASSWORD=

# Pagamenti: lasciare vuoto finché non esiste un provider verificato.
# Con questa variabile impostata l'interfaccia mostra "pagamenti configurabili",
# ma nessun addebito viene eseguito dal codice.
# GM_PAYMENTS_PROVIDER=
